# AICOACH — публичный демо-бот, отдельный инстанс/токен от вашего приватного.
# Открыт всем в Telegram: multi-user (каждый чат — свой изолированный, обезличенный
# профиль), дешёвая модель, дневной лимит сообщений, шифрование памяти at-rest.

PUBLIC_MODE=true

# Соль для хеша chat_id → tenant_id (никогда не публикуйте это значение).
# Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
TENANT_SALT=<random-hex>

# Ключ шифрования памяти at-rest (Fernet). Держите в секрете, отдельно от бэкапов.
# Сгенерировать: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MEMORY_ENCRYPTION_KEY=<fernet-key>

# Дешёвая модель для публичного демо (через OpenRouter). DeepSeek v4 Flash —
# на июль 2026 одна из самых дешёвых reasoning-моделей ($0.10 / $0.20 за M ток.).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=<your-openrouter-key>
LLM_MODEL=z-ai/glm-5.2          # см. docs/model-comparison.md (качество/цена)
# REASONING_EFFORT=low          # только для reasoning-моделей (kimi-k3 и т.п.),
                                # иначе они сожгут бюджет на скрытое размышление

# Telegram — ОТДЕЛЬНЫЙ токен от приватного бота (@BotFather → /newbot)
TG_BOT_TOKEN=<demo-bot-token>
# ALLOWED_CHAT_ID игнорируется в PUBLIC_MODE — бот открыт всем.

# Защита бюджета: сообщений в день на один чат.
DAILY_MESSAGE_LIMIT=30

# STT (опционально)
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3

# Супервизия — офлайн-ревью разборов старшей моделью (./supervise.py).
# Пусто = захват только проблемных кейсов (+ малый контрольный сэмпл).
# SUPERVISED_TENANTS — список тенантов, у которых в разбор идёт ВСЁ подряд.
# Внимание: значение зависит от режима. В PUBLIC_MODE это hashed tenant_id
# (соль+sha256 от chat_id, первые 24 симв — смотри имя каталога в tenants/),
# в приватном режиме — просто TENANT_ID.
SUPERVISED_TENANTS=
SUPERVISION_RETENTION_DAYS=90
SUPERVISION_SAMPLE_PCT=5
# SUPERVISOR_MODEL=anthropic/claude-opus-4.5   # модель-критик, сильнее рабочей
