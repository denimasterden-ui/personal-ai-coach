# AICOACH .env — скопировать в .env рядом с сервисом, заполнить, chmod 600.

# --- Модель (model-agnostic, OpenAI-совместимый endpoint) ---
# Варианты LLM_BASE_URL:
#   https://openrouter.ai/api/v1          — OpenRouter (в т.ч. free-tier open-weight)
#   http://localhost:4000/v1              — свой LiteLLM
#   http://localhost:11434/v1             — локальный Ollama (self-host open-weight)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=<your-api-key>
# id модели у выбранного провайдера, напр.:
#   anthropic/claude-sonnet-4.5 · deepseek/deepseek-chat · qwen/qwen-2.5-72b-instruct · llama-3.3-70b
LLM_MODEL=<model-id>

# --- Telegram ---
TG_BOT_TOKEN=<token-from-@BotFather>
# chat_id того, кому разрешён доступ. Пусто = бот вернёт твой chat_id при первом
# сообщении (и не пустит), впиши его сюда и перезапусти.
ALLOWED_CHAT_ID=

# --- STT (голос → текст). Пусто = только текст. ---
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3

# Профиль хранится в tenants/<TENANT_ID>/ . Для single-user оставь default.
TENANT_ID=default
