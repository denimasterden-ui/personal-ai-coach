# Скопируй в deploy/deploy.env (в .gitignore) и заполни своими значениями.
# НЕ коммить deploy.env — там адрес сервера и путь к ключу.

HOST=your.server.ip
SSH_USER=root
SSH_KEY=$HOME/.ssh/your_deploy_key
REMOTE_DIR=/opt/aicoach-demo/aicoach-service

# порт FastAPI-мозга (его /health отдаёт {"active": N} — гейт «тихого окна»)
HEALTH_PORT=8092

# имена systemd-юнитов на сервере
UNIT_SERVICE=aicoach-demo-service
UNIT_BOT=aicoach-demo-bot

# сколько раз (× 3с) ждать active=0, прежде чем прервать деплой
MAX_TRIES=20
